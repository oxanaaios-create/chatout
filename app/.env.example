# PayPal sandbox app: developer.paypal.com > Apps & Credentials > Sandbox > Create App
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Optional: pay each store directly (one purchase unit per store).
# Needs PayPal multi-seller access; leave 0 to pay one sandbox account.
MULTI_PAYEE=0
PAYEE_TOURTIX=
PAYEE_NOVALANE=
PAYEE_ORO=
PAYEE_TOOLBARN=
PAYEE_PIXEL=

# Optional AI: free key from aistudio.google.com. Without it the agent uses rules.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
